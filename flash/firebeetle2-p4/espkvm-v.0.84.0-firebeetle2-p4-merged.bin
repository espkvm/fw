␀␀e0319e␀␀{"target_os":"linux","mouse_mode":"relative","ptr_desk_w":0,"ptr_desk_h":0,"ui_hidden":"netlog,serial"}␀Nintendo␀␀␀␀0009bf␀␀{"usb_pad":"switch_alone","ui_hidden":"copy,keyboard,keylock,netlog,padmouse,select,serial"}␀␀␀␀androidtv␀␀␀Android TV␀␀{"target_os":"android","mouse_mode":"relative","ui_hidden":"copy,netlog,select,serial"}␀mitvstick␀␀␀Mi TV Stick␀{"target_os":"android","mouse_mode":"relative","ui_hidden":"copy,gamepad,keyboard,keylock,netlog,padmouse,select,serial,touch"}␀temperature_sensor␀␀E (%lu) %s: %s(%d): tsens not in init state
